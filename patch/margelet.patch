diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index 2aa197cb..8fd9c9ec 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -67,10 +67,19 @@ android {
             shrinkResources false
             multiDexEnabled true
             proguardFiles getDefaultProguardFile('proguard-android.txt'), '../TMessagesProj/proguard-rules.pro', '../TMessagesProj/proguard-rules-beta.pro'
-            ndk.debugSymbolLevel = 'FULL'
+            // Отладочные символы нативных библиотек нужны только для
+            // расшифровки крэшей в консоли гугла — их сотни мегабайт, и на
+            // здешнем диске это была разница между сборкой и «нет места».
+            ndk.debugSymbolLevel = 'NONE'
         }
 
         standalone {
+            // У модуля с формулами есть только debug и release, а этот тип
+            // сборки называется иначе — без явной подмены gradle не знает,
+            // какой вариант чужого модуля брать, и падает на разрешении
+            // зависимостей. В самой библиотеке такая строка уже стояла,
+            // в приложении её не было.
+            matchingFallbacks = ['release']
             debuggable false
             jniDebuggable false
             signingConfig signingConfigs.release
@@ -79,7 +88,8 @@ android {
             shrinkResources false
             multiDexEnabled true
             proguardFiles getDefaultProguardFile('proguard-android.txt'), '../TMessagesProj/proguard-rules.pro'
-            ndk.debugSymbolLevel = 'FULL'
+            // Символы не кладём: см. debug — здесь та же экономия места.
+            ndk.debugSymbolLevel = 'NONE'
         }
 
         release {
@@ -136,7 +146,10 @@ android {
         }
         afat {
             ndk {
-                abiFilters "armeabi-v7a", "arm64-v8a", "x86", "x86_64"
+                // Только arm64: телефон у нас один, а каждая лишняя архитектура
+                // это ещё одна полная сборка нативной части — время и место,
+                // которого в контейнере впритык.
+                abiFilters "arm64-v8a"
             }
             sourceSets.debug {
                 manifest.srcFile '../TMessagesProj/config/debug/AndroidManifest_SDK23.xml'
diff --git a/TMessagesProj_AppStandalone/build.gradle b/TMessagesProj_AppStandalone/build.gradle
index 96f4d779..427c823a 100644
--- a/TMessagesProj_AppStandalone/build.gradle
+++ b/TMessagesProj_AppStandalone/build.gradle
@@ -79,11 +79,12 @@ android {
             debuggable false
             jniDebuggable false
             signingConfig signingConfigs.release
-            applicationIdSuffix ".web"
+            // Суффикс убран: имя пакета теперь наше целиком, cat.narezany.margelet,
+            // и приписка про веб-версию телеграма к нему не относится.
             minifyEnabled true
             multiDexEnabled true
             proguardFiles getDefaultProguardFile('proguard-android.txt'), '../TMessagesProj/proguard-rules.pro'
-            ndk.debugSymbolLevel = 'FULL'
+            ndk.debugSymbolLevel = 'NONE'
         }
     }
 
@@ -99,7 +100,9 @@ android {
     productFlavors {
         afat {
             ndk {
-                abiFilters "armeabi-v7a", "arm64-v8a", "x86", "x86_64"
+                // Только arm64: библиотека нативную часть под остальные три
+                // больше не собирает, да и телефон у владельца один.
+                abiFilters "arm64-v8a"
             }
             ext {
                 abiVersionCode = 9
@@ -154,4 +157,10 @@ android {
     }
 }
 
-apply plugin: 'com.google.gms.google-services'
+// Плагин отключён вместе со сменой имени пакета. Лежащий в исходниках
+// google-services.json описывает firebase-проект самого телеграма, и наш
+// пакет в нём не значится — сборка на этом и падала. Дописывать себя в чужой
+// проект я не стал: это их облако, а не наше. Цена решения честная: пуши в
+// фоне работать не будут, пока у форка нет своего файла google-services.json.
+// Как только он появится — вернуть эту строку и положить файл рядом.
+// apply plugin: 'com.google.gms.google-services'
